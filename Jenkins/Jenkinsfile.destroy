pipeline {
    agent any

    environment {
        TF_DIR = 'Terraform'
    }

    parameters {
        choice(
            name: 'ENV',
            choices: ['dev', 'prod'],
            description: 'Choose environment to destroy'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir("${TF_DIR}") {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-creds']
                    ]) {

                        sh '''
                            unset AWS_PROFILE
                            unset AWS_DEFAULT_PROFILE
                            terraform init
                        '''
                    }
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir("${TF_DIR}") {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Destroy Plan (Optional but recommended)') {
            steps {
                dir("${TF_DIR}") {

                    script {
                        def tfvarsCred = (params.ENV == 'dev')
                            ? 'dev-tfvars'
                            : 'prod-tfvars'

                        withCredentials([
                            file(credentialsId: tfvarsCred, variable: 'TFVARS_FILE'),
                            [$class: 'AmazonWebServicesCredentialsBinding',
                             credentialsId: 'aws-creds']
                        ]) {

                            sh '''
                                unset AWS_PROFILE
                                unset AWS_DEFAULT_PROFILE
                                terraform plan -destroy -var-file=$TFVARS_FILE
                            '''
                        }
                    }
                }
            }
        }

        stage('DESTROY - FINAL APPROVAL') {
            steps {
                input message: "⚠️ CONFIRM DESTROY for ${params.ENV}? This cannot be undone!"

                dir("${TF_DIR}") {

                    script {
                        def tfvarsCred = (params.ENV == 'dev')
                            ? 'dev-tfvars'
                            : 'prod-tfvars'

                        withCredentials([
                            file(credentialsId: tfvarsCred, variable: 'TFVARS_FILE'),
                            [$class: 'AmazonWebServicesCredentialsBinding',
                             credentialsId: 'aws-creds']
                        ]) {

                            sh '''
                                unset AWS_PROFILE
                                unset AWS_DEFAULT_PROFILE
                                terraform destroy -auto-approve -var-file=$TFVARS_FILE
                            '''
                        }
                    }
                }
            }
        }
    }
}