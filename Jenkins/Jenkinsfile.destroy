pipeline {
    agent any

    environment {
        TF_DIR = 'Terraform/infra'
    }

    parameters {
        choice(
            name: 'ENV',
            choices: ['dev', 'prod'],
            description: 'Choose environment to destroy'
        )
    }

    stages {

        stage('Terraform Init') {
            steps {
                dir("${TF_DIR}") {
                    sh """
                        terraform init -reconfigure \
                          -backend-config="key=${params.ENV}/terraform.tfstate"
                    """
                }
            }
        }

        stage('Terraform Destroy Plan') {
            steps {
                dir("${TF_DIR}") {
                    script {
                        def tfvarsCred = (params.ENV == 'dev') ? 'dev-tfvars' : 'prod-tfvars'

                        withCredentials([
                            file(credentialsId: tfvarsCred, variable: 'TFVARS_FILE')
                        ]) {
                            sh '''
                                terraform plan -destroy -var-file="$TFVARS_FILE" -out=tfplan -input=false
                                terraform show -no-color tfplan > tfplan.txt
                            '''
                            archiveArtifacts artifacts: 'tfplan.txt', allowEmptyArchive: true
                        }
                    }
                }
            }
        }

        stage('Destroy Approval (Auto)') {
            steps {
                echo "⚠️ Auto-approved destroy for ${params.ENV}"
                echo "Proceeding without manual approval..."
            }
        }

        stage('Terraform Destroy Apply') {
            steps {
                dir("${TF_DIR}") {
                    sh '''
                        terraform apply -auto-approve -input=false tfplan
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Destroy pipeline completed successfully for ${params.ENV}."
        }
        failure {
            echo "❌ Destroy pipeline failed. Check logs for details."
        }
        always {
            cleanWs()
        }
    }
}