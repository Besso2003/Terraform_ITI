pipeline {
    agent any

    environment {
        TF_DIR = 'Terraform'
    }

    parameters {
        choice(
            name: 'ENV',
            choices: ['dev', 'prod'],
            description: 'Choose environment to destroy'
        )
    }

    stages {
        // ❌ No Checkout stage here

        stage('Terraform Init') {
            steps {
                dir("${TF_DIR}") {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-creds']
                    ]) {
                        sh """
                            unset AWS_PROFILE
                            unset AWS_DEFAULT_PROFILE
                            terraform init -reconfigure \
                              -backend-config="key=${params.ENV}/terraform.tfstate"
                        """
                    }
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir("${TF_DIR}") {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Destroy Plan') {
            steps {
                dir("${TF_DIR}") {
                    script {
                        def tfvarsCred = (params.ENV == 'dev') ? 'dev-tfvars' : 'prod-tfvars'
                        withCredentials([
                            file(credentialsId: tfvarsCred, variable: 'TFVARS_FILE'),
                            [$class: 'AmazonWebServicesCredentialsBinding',
                             credentialsId: 'aws-creds']
                        ]) {
                            sh '''
                                unset AWS_PROFILE
                                unset AWS_DEFAULT_PROFILE
                                terraform plan -destroy -var-file=$TFVARS_FILE \
                                  -out=tfplan -input=false
                                terraform show -no-color tfplan > tfplan.txt
                            '''
                            archiveArtifacts artifacts: 'tfplan.txt', allowEmptyArchive: false
                        }
                    }
                }
            }
        }

        stage('DESTROY - FINAL APPROVAL') {
            steps {
                script {
                    def plan = readFile("${TF_DIR}/tfplan.txt")
                    input message: "⚠️ CONFIRM DESTROY for ${params.ENV}? This cannot be undone!\n\n${plan.take(2000)}"
                }
                dir("${TF_DIR}") {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-creds']
                    ]) {
                        sh '''
                            unset AWS_PROFILE
                            unset AWS_DEFAULT_PROFILE
                            terraform destroy -auto-approve -input=false tfplan
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Destroy pipeline completed successfully for ${params.ENV}."
        }
        failure {
            echo "❌ Destroy pipeline failed. Check the console output for details."
        }
        always {
            cleanWs()
        }
    }
}