pipeline {
    agent any

    environment {
        TF_DIR = 'Terraform'
        AWS_PROFILE = ""
    }

    parameters {
        choice(
            name: 'ENV',
            choices: ['dev', 'prod'],
            description: 'Choose environment'
        )
    }

    stages {

        stage('Terraform Init') {
            steps {
                dir("${TF_DIR}") {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-creds']
                    ]) {
                        sh """
                            unset AWS_PROFILE
                            unset AWS_DEFAULT_PROFILE
                            terraform init -reconfigure \
                              -backend-config="key=${params.ENV}/terraform.tfstate"
                        """
                    }
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir("${TF_DIR}") {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir("${TF_DIR}") {

                    script {
                        def tfvarsCred = (params.ENV == 'dev')
                            ? 'dev-tfvars'
                            : 'prod-tfvars'

                        withCredentials([
                            file(credentialsId: tfvarsCred, variable: 'TFVARS_FILE'),
                            [$class: 'AmazonWebServicesCredentialsBinding',
                             credentialsId: 'aws-creds']
                        ]) {

                            sh """
                                unset AWS_PROFILE
                                unset AWS_DEFAULT_PROFILE
                                terraform plan -var-file=$TFVARS_FILE -out=tfplan -input=false
                                terraform show -no-color tfplan > tfplan.txt
                            """
                            archiveArtifacts artifacts: 'tfplan.txt', allowEmptyArchive: false
                        }
                    }
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                script {
                    def plan = readFile("${TF_DIR}/tfplan.txt")
                    input message: "Approve deployment for ${params.ENV}?\n\n${plan.take(2000)}"
                }

                dir("${TF_DIR}") {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-creds']
                    ]) {
                        sh """
                            unset AWS_PROFILE
                            unset AWS_DEFAULT_PROFILE
                            terraform apply -auto-approve -input=false tfplan
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Deployment pipeline completed successfully for ${params.ENV}."
        }
        failure {
            echo "❌ Deployment pipeline failed. Check the console output for details."
        }
        always {
            cleanWs()
        }
    }
}