pipeline {
    agent any

    environment {
        TF_DIR = 'Terraform'
        AWS_PROFILE = ""
    }

    parameters {
        choice(
            name: 'ENV',
            choices: ['dev', 'prod'],
            description: 'Choose environment'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir("${TF_DIR}") {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-creds']
                    ]) {
                        sh '''
                            unset AWS_PROFILE
                            unset AWS_DEFAULT_PROFILE
                            terraform init
                        '''
                    }
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir("${TF_DIR}") {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir("${TF_DIR}") {

                    script {
                        def tfvarsCred = (params.ENV == 'dev')
                            ? 'dev-tfvars'
                            : 'prod-tfvars'

                        withCredentials([
                            file(credentialsId: tfvarsCred, variable: 'TFVARS_FILE'),
                            [$class: 'AmazonWebServicesCredentialsBinding',
                             credentialsId: 'aws-creds']
                        ]) {

                            sh '''
                                unset AWS_PROFILE
                                unset AWS_DEFAULT_PROFILE
                                terraform plan -var-file=$TFVARS_FILE
                            '''
                        }
                    }
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                input message: "Approve deployment for ${params.ENV}?"

                dir("${TF_DIR}") {

                    script {
                        def tfvarsCred = (params.ENV == 'dev')
                            ? 'dev-tfvars'
                            : 'prod-tfvars'

                        withCredentials([
                            file(credentialsId: tfvarsCred, variable: 'TFVARS_FILE'),
                            [$class: 'AmazonWebServicesCredentialsBinding',
                             credentialsId: 'aws-creds']
                        ]) {

                            sh '''
                                unset AWS_PROFILE
                                unset AWS_DEFAULT_PROFILE
                                terraform apply -auto-approve -var-file=$TFVARS_FILE
                            '''
                        }
                    }
                }
            }
        }
    }
}