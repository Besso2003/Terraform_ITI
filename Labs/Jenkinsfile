pipeline {
    agent any

    stages {

        stage('Clone Repository') {
            steps {
                git 'https://github.com/Besso2003/Terraform_ITI.git'
            }
        }

        stage('Terraform Init') {
            steps {
                dir('Labs') {
                    sh 'terraform init'
                }
            }
        }


        stage('Terraform Plan') {
            steps {
                dir('Labs') {
                    sh 'terraform plan'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('Labs') {
                    sh 'terraform apply -auto-approve'
                }
            }
        }
    }
}